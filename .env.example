# ─── Telegram ───────────────────────────────────────────────────────────────
# Get this from @BotFather. DO NOT reuse the token that was shared in chat —
# revoke it in BotFather first (/mybots → your bot → API Token → Revoke), then
# paste the fresh one here.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram numeric user IDs allowed to command the bot.
# Leave empty to allow anyone who can message the bot. Use /whoami to find an id.
TELEGRAM_ALLOWED_USER_IDS=

# ─── Zoom join behaviour ──────────────────────────────────────────────────────
# The name the bot shows as in the meeting. Keep it clearly bot-like so the
# meeting is not misled about who/what joined.
ZOOM_BOT_DISPLAY_NAME=Zoombot (Notetaker)

# ─── Headless browser ─────────────────────────────────────────────────────────
# "true" runs Chromium headless (servers). Set "false" to watch it locally while
# debugging selectors.
PUPPETEER_HEADLESS=true

# How long (ms) to wait for each Zoom web-client step before giving up.
ZOOM_STEP_TIMEOUT_MS=45000

# Save a screenshot to ./debug-screenshots on join failure (helps when Zoom
# changes its web-client DOM and a selector needs updating).
ZOOM_DEBUG_SCREENSHOTS=true

# ─── Selector overrides (advanced) ────────────────────────────────────────────
# Zoom changes its web-client markup without notice. If a join starts failing,
# inspect the page and override the relevant selector here (comma-separate
# fallbacks). Leave empty to use the built-in defaults.
ZOOM_SEL_NAME_INPUT=
ZOOM_SEL_PASSCODE_INPUT=
ZOOM_SEL_JOIN_BUTTON=

# ─── App ──────────────────────────────────────────────────────────────────────
# Port for the GET /health endpoint.
HEALTH_PORT=3000
